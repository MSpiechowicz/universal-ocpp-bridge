      "anyOf": [
        {
          "$ref": "#/$defs/ReservationConnectorType201"
        },
        {
          "type": "null"
        }
      ]
    },
    "evseId": {
      "description": "Absent means an unspecified EVSE, which requires explicit `NonEvseSpecific` support.",
