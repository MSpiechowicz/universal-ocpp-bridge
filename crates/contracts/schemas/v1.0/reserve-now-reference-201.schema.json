        "cG105",
        "cTesla",
        "cType1",
        "cType2",
        "s309-1P-16A",
        "s309-1P-32A",
        "s309-3P-16A",
        "s309-3P-32A",
        "sBS1361",
        "sCEE-7-7",
        "sType2",
        "sType3",
        "Other1PhMax16A",
        "Other1PhOver16A",
        "Other3Ph",
        "Pan",
        "wInductive",
        "wResonant",
        "Undetermined",
        "Unknown"
      ],
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$id": "https://schemas.universal-ocpp-bridge.dev/contracts/v1.0/reserve-now-reference-201.schema.json",
