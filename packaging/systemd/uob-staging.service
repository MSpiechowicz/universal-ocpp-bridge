[Unit]
Requires=uob-staging-governor.service
After=uob-staging-governor.service
BindsTo=uob-staging-governor.service
Description=Universal OCPP Bridge staging
Requires=uob-staging-network.service
After=uob-staging-network.service
BindsTo=uob-staging-network.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
WatchdogSec=10s
TimeoutAbortSec=5s
LimitCORE=0
User=uob-staging
Group=uob-staging
Slice=uob-staging.slice
NetworkNamespacePath=/run/netns/uob-staging
RestrictNamespaces=yes
Environment=UOB_DEPLOYMENT_ENVIRONMENT=staging
InaccessiblePaths=-/etc/uob -/var/lib/uob -/run/uob
ExecStartPre=/usr/local/bin/uob config check --config /etc/uob-staging/bridge.toml
ExecStart=/usr/local/bin/uob serve --config /etc/uob-staging/bridge.toml --no-ui
WorkingDirectory=/var/lib/uob-staging
StateDirectory=uob-staging
StateDirectoryMode=0700
RuntimeDirectory=uob-staging
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
# Preserve each termination before restart replaces the current unit status.
ExecStopPost=/usr/bin/printf "uob_service_exit result=%%s code=%%s status=%%s invocation=%%s\n" "${SERVICE_RESULT}" "${EXIT_CODE}" "${EXIT_STATUS}" "${INVOCATION_ID}"
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
LogNamespace=uob-staging
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
