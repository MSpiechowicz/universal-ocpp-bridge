[Unit]
Description=Universal OCPP Bridge independent release supervisor
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
# Independent administrator-owned installation; never selected from an app bundle.
ExecStart=/usr/local/libexec/uob-release-manager serve /etc/uob-release-manager/supervisor.json
User=root
Group=uob-release-control
StateDirectory=uob-release-manager
StateDirectoryMode=0700
RuntimeDirectory=uob-release-manager
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
KillMode=control-group
LimitCORE=0
MemoryMax=64M
TasksMax=16
LimitNOFILE=64
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/uob-releases
InaccessiblePaths=-/var/lib/uob -/var/lib/uob-staging -/etc/uob -/etc/uob-staging
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
