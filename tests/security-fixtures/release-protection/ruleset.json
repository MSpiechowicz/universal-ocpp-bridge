{
  "name": "Reviewed main changes",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 12345,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Format, lint, test, and architecture",
            "integration_id": 15368
          },
          {
            "context": "PR title, commit range, and documentation",
            "integration_id": 15368
          },
          {
            "context": "Rust advisories, licenses, and sources",
            "integration_id": 15368
          },
          {
            "context": "Secret scanning",
            "integration_id": 15368
          },
          {
            "context": "GitHub Actions policy",
            "integration_id": 15368
          },
          {
            "context": "Locked source SBOM",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
